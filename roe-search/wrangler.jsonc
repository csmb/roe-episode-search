{
  "name": "roe-episode-search",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",
  // Serve only on rollovereasy.org (custom domain, set in the dashboard). The
  // default *.workers.dev copy and preview URLs would bypass anything set up on
  // that zone, such as Cloudflare Access on /admin.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roe-episodes",
      "database_id": "cc7207a0-a581-4d3a-9c8f-12597b1ab46d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "roe-audio"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "roe-transcripts"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Per-IP request budgets, one for each kind of API route: rateLimiterFor() in
  // src/index.js says which route spends which. A namespace_id can be any
  // positive integer, but it is account-wide: a Worker reusing one shares its counts.
  "ratelimits": [
    // Keyword search. Only the admin page has a search box, but the route is public.
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    // Semantic search: every request runs Workers AI and Vectorize, which are billed.
    {
      "name": "SEMANTIC_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    // Map places, place detail, the episode and guest lists, On This Day. A page
    // view asks for one of these, plus one per place opened on the map.
    {
      "name": "BROWSE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 }
    },
    // One episode, or its places. Each card on /episodes asks for its places as
    // it scrolls into view: scrolling the whole archive makes hundreds of these.
    {
      "name": "EPISODE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 1000, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": false
    },
    // The header photo: imported as bytes and served by the Worker.
    {
      "type": "Data",
      "globs": ["**/*.webp"],
      "fallthrough": false
    }
  ]
}
