{
  "name": "roe-episode-search",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",
  // Serve only on rollovereasy.org (custom domain, set in the dashboard). The
  // default *.workers.dev copy and preview URLs would bypass anything set up on
  // that zone, such as Cloudflare Access on /admin.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roe-episodes",
      "database_id": "cc7207a0-a581-4d3a-9c8f-12597b1ab46d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "roe-audio"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "roe-transcripts"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": false
    },
    // The header photo: imported as bytes and served by the Worker.
    {
      "type": "Data",
      "globs": ["**/*.webp"],
      "fallthrough": false
    }
  ]
}
